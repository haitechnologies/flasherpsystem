# ============================================================================
# SECURITY: Protect Database Migrations Directory
# ============================================================================
# SQL migration files expose full schema and seeded data.
# Absolutely must not be web-accessible.
Options -Indexes
IndexIgnore *

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
